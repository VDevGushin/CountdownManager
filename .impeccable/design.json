  "narrative": {
    "northStar": "Warm Calendar Leaves",
    "overview": "Countdown Manager uses warm paper and terracotta calendar leaves to make a small dated-event utility feel tangible. Georgia gives event names and dates an editorial character; compact native system text keeps actions, settings, and checklists legible. The warm dark appearance preserves the same hierarchy through related surfaces rather than applying a neutral black theme.\n\nThis is a record of the completed native macOS implementation, adapted from the user-approved imported HTML and corrected icon-field reference. It is not a seed or a web implementation specification. SwiftUI and AppKit remain authoritative for native controls, focus, accessibility, and platform metrics.",
    "keyCharacteristics": [
      "Warm ivory, terracotta, and related warm dark surfaces.",
      "Georgia calendar numerals and event headings with native system controls.",
      "A compact retained panel with a distinct timer strip and fixed service actions.",
      "Calendar leaves provide the signature; quiet tonal surfaces group events and checklists."
    ],
    "rules": [
      {
        "name": "The Calendar Leaf Rule",
        "body": "Use the leaf to carry the actual month and day; the larger featured leaf sits on the right and secondary leaves on the left.",
        "section": "typography"
      },
      {
        "name": "The Native Control Rule",
        "body": "Preserve native text entry, checkbox, date, menu, focus, disabled, and keyboard behavior when extending the interface.",
        "section": "typography"
      },
      {
        "name": "The Paper Depth Rule",
        "body": "Use tonal surfaces for event grouping and reserve the small paper shadow and rotation for calendar leaves.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use the paired light and dark semantic colors from AuroraInstrument, including Increase Contrast adaptations.",
      "Do preserve Georgia for featured event titles, calendar numerals, and internal screen headings.",
      "Do keep focus rings visible within scrolling forms and preserve native checkbox and date controls.",
      "Do respect Reduce Motion and keep the timer and fixed action rows available while forms scroll.",
      "Do distinguish the icon selection field from text entry and keep its clear action separate from disclosure."
    ],
    "donts": [
      "Don't replace semantic icons with text glyph approximations in production controls.",
      "Don't introduce panel motion or forced focus transitions into ordinary navigation.",
      "Don't make every event equally prominent; retain featured and secondary calendar-leaf sizes.",
      "Don't promote illustrative HTML previews in the sidecar into native control specifications."
    ]
  }
}
